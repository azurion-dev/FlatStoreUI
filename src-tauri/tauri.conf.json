{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlatStore",
  "version": "0.1.0",
  "identifier": "com.flatstore.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "FlatStore", "width": 1180, "height": 780, "minWidth": 520, "minHeight": 520, "decorations": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
